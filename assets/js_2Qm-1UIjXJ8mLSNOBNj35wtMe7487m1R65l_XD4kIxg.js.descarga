(function($,Drupal){"use strict";var winwidth;var winheight;function valignStuff(){$('.valign').each(function(){var pheight=$(this).parent('div, span').height();var vheight=$(this).height();var vbump=(pheight-vheight)/2;$(this).css('margin-top',vbump+'px');});}function videoCenter(){winwidth=$(window).width();winheight=$(window).height();if(winwidth>=1024){$('#bgVideo').css('width','1920px');var vidbump=(1920-winwidth)/2;$('#bgVideo').css('margin-left','-'+vidbump+'px');}}function iwsCount(){$('.counter').each(function(){var number=$(this).attr('numberval');var numberval=parseInt(number);$(this).countTo({from:1,to:numberval,speed:1000,refreshInterval:50,onComplete:function(value){console.debug(this);}});});}function countNumbers(){winheight=$(window).height();winwidth=$(window).width();$('.counters').each(function(){if($(this).attr('scrolled')=='no'){var animval=$(this).attr('anim');animval=parseInt(animval);if(winwidth>=1024)var windowbump=winheight*.4;else var windowbump=winheight*.1;var windowtrigger=$(window).scrollTop()+winheight-windowbump;var windowreset=$(window).scrollTop()+winheight;if(windowtrigger>=animval){iwsCount();$(this).attr('scrolled','yes');}}});}$(window).on('resize',function(){valignStuff();slideshow();videoCenter();});$(window).on('load',function(){valignStuff();slideshow();videoCenter();var ctaparam='';ctaparam=getUrlParameter('scroll');if(ctaparam!=undefined)$('html, body').animate({scrollTop:$("#"+ctaparam).offset().top-5},500);});function slideshow(){winheight=$(window).height();winwidth=$(window).width();if(winwidth<=1920){var slidebump=(winwidth-1920)/2;$('#location-top .map .center').css('margin-left',slidebump+'px');}}function getUrlParameter(sParam){var sPageURL=decodeURIComponent(window.location.search.substring(1)),sURLVariables=sPageURL.split('&'),sParameterName,i;for(i=0;i<sURLVariables.length;i++){sParameterName=sURLVariables[i].split('=');if(sParameterName[0]===sParam)return sParameterName[1]===undefined?true:sParameterName[1];}}$(document).ready(function(){winheight=$(window).height();winwidth=$(window).width();valignStuff();slideshow();videoCenter();$('#menu-push').click(function(){if($(this).hasClass('active')){$('#header nav, #block-imageworks-languageswitchercontent').slideUp('slow');$(this).removeClass('active');}else{$('#header nav, #block-imageworks-languageswitchercontent').slideDown('slow');$(this).addClass('active');}});$('#block-imageworks-main-menu > ul.menu > li.menu-item.menu-item--expanded > a').click(function(e){e.preventDefault();if($(this).hasClass('open')){var winwidth=$(window).width();if(winwidth<=1023)$(this).siblings('ul.menu').slideUp('slow');$(this).removeClass('open');}else{var winwidth=$(window).width();if(winwidth<=1023)$(this).siblings('ul.menu').slideDown('slow');$(this).addClass('open');}});$('#hero-arrow img').click(function(){$('html, body').animate({scrollTop:$("#home1").offset().top},500);});var scrollpast=$("#header").offset().top;$(window).scroll(function(){if(winwidth>1023&&$(window).scrollTop()>scrollpast){$('#header').addClass('anchored');$('#header-wrap').addClass('push-down');}else{if(winwidth>1023&&$(window).scrollTop()<=scrollpast){$('#header').removeClass('anchored');$('#header-wrap').removeClass('push-down');}}});$('.view-testimonials .view-filters form').after('<p><a class="cta-btn" href="/content/contact-us">Request an Appointment</a></p>');$('#locations .location strong').click(function(){var id=$(this).attr('id');$('#locations .location strong').each(function(){$(this).removeClass('active');});$(this).addClass('active');$('#contact-maps .map').each(function(){$(this).removeClass('active');});$('#contact-maps .map#'+id).addClass('active');});var param='';param=getUrlParameter('field_category_target_id');if(param=="8")$('.view-testimonials .view-content').prepend('<h2>Cataract Testimonials</h2>');else if(param=="6")$('.view-testimonials .view-content').prepend('<h2>Oculoplastic Testimonials</h2>');else if(param=="9")$('.view-testimonials .view-content').prepend('<h2>Other Procedures Testimonials</h2>');else $('.view-testimonials .view-content').prepend('<h2>LASIK Testimonials</h2>');$('.ref-link, .inner.linked').each(function(){var ref=$(this).attr('ref');$(this).wrapAll('<a href="'+ref+'"></a>');});$('.service.linked').each(function(){var ref=$(this).attr('ref');$(this).wrapAll('<a href="'+ref+'"></a>');});$('.counters').each(function(){var animval=$(this).offset().top;$(this).attr('anim',animval);$(this).find('.animate').addClass('go');$(this).attr('scrolled','no');});$('.counter').each(function(){var val=$(this).text();$(this).attr('numberval',val);$(this).text('1');});$(window).scroll(function(){countNumbers();});if($(".page-node-233 #paragraph-116").length){var evoscrollpast=$(".page-node-233 #paragraph-116").offset().top;evoscrollpast=evoscrollpast-100;}$(window).scroll(function(){if($(".page-node-233 #paragraph-116").length&&$(window).scrollTop()>evoscrollpast)$('#paragraph-116').addClass('night');else{if($(".page-node-233 #paragraph-116").length&&$(window).scrollTop()<=evoscrollpast)$('#paragraph-116').removeClass('night');}});$('.info-bubble .bubble-open').hover(function(){$(this).parents('.info-bubble').addClass('active');},function(){$(this).parents('.info-bubble').removeClass('active');});$('.accordion .accordion-item').click(function(){if($(this).hasClass('open')){$(this).find('.answer').stop().slideUp(400);$(this).removeClass('open');}else{$(this).addClass('open');$(this).find('.answer').stop().slideDown(500);}});$('#yt-replace').click(function(){$('.page-node-228 #paragraph-105 .right').html('<iframe title="YouTube video player" src="https://www.youtube.com/embed/sk8Uq_9p5hQ?autoplay=1&rel=0" width="1000" height="475" frameborder="0" allowfullscreen="allowfullscreen" allow="autoplay" style="margin-top:40px; max-width:100%;" ></iframe>');});document.querySelectorAll('.acc-btn').forEach((btn)=>{btn.addEventListener('click',()=>{const item=btn.closest('.acc-item');const open=item.classList.contains('open');document.querySelectorAll('.acc-item').forEach((i)=>i.classList.remove('open'));if(!open)item.classList.add('open');});});$('#anchor-menu .text-formatted a').click(function(e){e.preventDefault();var anchorid=$(this).attr('href');var headerheight=$('#header-wrap').height();$('html, body').animate({scrollTop:$(anchorid).offset().top-headerheight},500);});});})(jQuery);;
(function($){$.fn.countTo=function(options){options=$.extend({},$.fn.countTo.defaults,options||{});var loops=Math.ceil(options.speed/options.refreshInterval),increment=(options.to-options.from)/loops;return $(this).each(function(){var _this=this,loopCount=0,value=options.from,interval=setInterval(updateTimer,options.refreshInterval);function updateTimer(){value+=increment;loopCount++;$(_this).html(value.toFixed(options.decimals));if(typeof (options.onUpdate)=='function')options.onUpdate.call(_this,value);if(loopCount>=loops){clearInterval(interval);value=options.to;if(typeof (options.onComplete)=='function')options.onComplete.call(_this,value);}}});};$.fn.countTo.defaults={from:0,to:100,speed:1000,refreshInterval:100,decimals:0,onUpdate:null,onComplete:null};})(jQuery);;
